  "license": "GPL-3.0",
  "devDependencies": {
    "@mate-academy/eslint-config": "latest",
    "@mate-academy/scripts": "^2.1.3",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^8.57.0",
    "eslint-plugin-jest": "^28.6.0",
    "eslint-plugin-node": "^11.1.0",
    "jest": "^29.7.0",
    "prettier": "^3.3.2",
    "vite": "^8.3.5"
  },
  "mateAcademy": {
    "projectType": "javascript"
  },
  "dependencies": {
    "axios": "^1.21.0",
    "cn": "^0.4.0",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sequelize": "^6.37.8",
    "uuid": "^14.0.3",
    "ws": "^8.22.0"
  }
